{
  "name": "pd-editor-vue",
  "version": "2.1.0",
  "description": "Vue 3 Markdown editor for technical content and AI writing workflows",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LaoChen1994/pd-markdown-editor.git",
    "directory": "packages/vue"
  },
  "homepage": "https://laochen1994.github.io/pd-markdown-editor/",
  "bugs": {
    "url": "https://github.com/LaoChen1994/pd-markdown-editor/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "vue",
    "codemirror",
    "mermaid",
    "technical-content",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "katex": "^0.16.45",
    "mermaid": "^11.15.0",
    "pd-editor-core": "workspace:*",
    "pd-markdown": "^2.1.1",
    "pd-markdown-ui": "^1.3.1"
  },
  "peerDependencies": {
    "vue": "^3.3.0 || ^3.4.0 || ^3.5.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vue": "^3.5.0"
  },
  "license": "MIT"
}
